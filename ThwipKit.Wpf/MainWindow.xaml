<Window x:Class="ThwipKit.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ThwipKit.Wpf.Views"
        xmlns:local="clr-namespace:ThwipKit.Wpf"
        Title="Spider-Man Modding Tool" Height="720" Width="1200" MinHeight="480" MinWidth="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Game Directory..." Click="OpenGameDirectory_Click" />
            </MenuItem>
            <MenuItem Header="_Project" DataContext="{Binding ProjectManager}">
                <MenuItem Header="_New..." Click="NewProject_Click" />
                <MenuItem Header="_Open..." Click="OpenProject_Click" />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" />
                <MenuItem Header="Save _As..." Click="SaveProjectAs_Click" />
                <MenuItem Header="_Close" Click="CloseProject_Click" />
                <MenuItem Header="_Properties..." Click="ProjectProperties_Click" />
                <Separator />
                <MenuItem Header="_Build" Click="BuildProject_Click" />
                <MenuItem Header="_Test Build" Click="TestBuildProject_Click" />
                <MenuItem Header="_Share..." Click="ShareProject_Click" />
                <MenuItem Header="_Validate" Click="ValidateProject_Click" />
                <MenuItem Header="S_hare..." Click="ShareProject_Click" />
                <Separator />
                <MenuItem Header="Recent Projects" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=MenuItem, AncestorLevel=2}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="Header" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit" />
            <MenuItem Header="_View" />
            <MenuItem Header="_Help" />
        </Menu>
        <Border DockPanel.Dock="Top" Height="40" Background="#FF1E2228">
            <StackPanel Orientation="Horizontal" Margin="8,0">
                <TextBlock Text="Game:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="GameCombo" Width="180"
                          ItemsSource="{Binding KnownGames}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedGame}"
                          SelectionChanged="GameCombo_SelectionChanged"
                          Margin="0,0,8,0" />
            </StackPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding GamePath}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding AssetCount, StringFormat=Assets: {0:N0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectManager.StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectManager.ValidationMessage}" />
            </StatusBarItem>
        </StatusBar>
        <Grid Background="#FF101317">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FF1A1F26" Padding="8" DataContext="{Binding ProjectManager}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#FF8C98A5" Text="Project: " />
                    <TextBlock Foreground="#FFE0E6EC" Text="{Binding ProjectName, TargetNullValue='(none)'}" FontWeight="SemiBold" />
                    <TextBlock Foreground="#FF8C98A5" Text="  " />
                    <TextBlock Foreground="{Binding HasUnsavedChanges, Converter={x:Static local:BoolToModifiedConverter.Instance}}"
                               Text="{Binding HasUnsavedChanges, Converter={x:Static local:BoolToModifiedConverter.Instance}}" />
                    <TextBlock Foreground="#FF8C98A5" Text="  Auto-save: " />
                    <TextBlock Foreground="#FFE0E6EC" Text="{Binding AutoSave}" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#FF8C98A5"
                       Text="Open a game directory to load its asset catalog." />
            <views:AssetBrowserView DataContext="{Binding AssetBrowser}">
                <views:AssetBrowserView.Style>
                    <Style TargetType="views:AssetBrowserView">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AssetBrowser}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:AssetBrowserView.Style>
            </views:AssetBrowserView>
        </Grid>
    </DockPanel>
</Window>
