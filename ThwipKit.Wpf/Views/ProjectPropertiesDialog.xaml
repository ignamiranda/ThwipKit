<Window x:Class="ThwipKit.Wpf.Views.ProjectPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Properties" Height="320" Width="440" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Name" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="4" />

        <Label Grid.Row="1" Grid.Column="0" Content="Target game" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="GameBox" Margin="4" SelectedIndex="0">
            <ComboBoxItem Content="MSMR" />
            <ComboBoxItem Content="MM" />
            <ComboBoxItem Content="RCRA" />
            <ComboBoxItem Content="I30" />
            <ComboBoxItem Content="I33" />
        </ComboBox>

        <Label Grid.Row="2" Grid.Column="0" Content="Game version" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="VersionBox" Margin="4" />

        <Label Grid.Row="3" Grid.Column="0" Content="Mod format" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="FormatBox" Margin="4" SelectedIndex="0">
            <ComboBoxItem Content=".smpcmod" />
            <ComboBoxItem Content=".stage" />
            <ComboBoxItem Content=".modular" />
            <ComboBoxItem Content=".suit" />
        </ComboBox>

        <Label Grid.Row="4" Grid.Column="0" Content="Author" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="AuthorBox" Margin="4" />

        <Label Grid.Row="5" Grid.Column="0" Content="Description" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="DescriptionBox" Margin="4" Height="56" TextWrapping="Wrap" AcceptsReturn="True" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="4" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" Margin="4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
