<UserControl x:Class="ThwipKit.Wpf.Views.AssetBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ThwipKit.Wpf.Converters"
             xmlns:vm="clr-namespace:ThwipKit.Wpf.ViewModels">
    <UserControl.Resources>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="#FF101317">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="3" Padding="14,10" Background="#FF191E24" BorderBrush="#FF323A44" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6" Content="Clear" Command="{Binding ClearFiltersCommand}" />
                <ComboBox DockPanel.Dock="Right" Width="160" Margin="8,0,0,0"
                          ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                          ToolTip="Filter by asset type">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox DockPanel.Dock="Right" Width="190" Margin="8,0,0,0" ItemsSource="{Binding ArchiveNames}"
                          SelectedItem="{Binding SelectedArchive}" ToolTip="Archive filter" />
                <ComboBox DockPanel.Dock="Right" Width="170" Margin="8,0,0,0"
                          ItemsSource="{Binding InternalTargetFilters}" SelectedItem="{Binding SelectedInternalTargetFilter}"
                          ToolTip="Filter by internal target" />
                <TextBox Padding="10,6" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search names or hexadecimal IDs (use AND/OR, e.g. 'hero OR material')">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="12" Background="#FF15191E" BorderBrush="#FF323A44" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="4,0,0,10" Foreground="#FF83D5FF" FontWeight="SemiBold" Text="ARCHIVES" />
                <TreeView ItemsSource="{Binding ArchiveTree}" Background="Transparent" Foreground="#FFE7EDF3"
                          SelectedItemChanged="ArchiveTree_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AssetsView}" SelectedItem="{Binding SelectedAsset}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" EnableRowVirtualization="True"
                  EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  MouseDoubleClick="AssetGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Asset ID" Binding="{Binding AssetIdHex}" Width="170" />
                <DataGridTextColumn Header="Resolved Name" Binding="{Binding ResolvedName}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource ByteSizeConverter}}" Width="100" />
                <DataGridTextColumn Header="Archive" Binding="{Binding ArchiveName}" Width="180" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Extract" Command="{Binding ExtractCommand}" />
                    <MenuItem Header="Replace..." Command="{Binding ReplaceCommand}" />
                    <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                    <MenuItem Header="Copy reference" Command="{Binding CopyReferenceCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <Border Grid.Row="1" Grid.Column="2" Padding="18" Background="#FF191E24" BorderBrush="#FF323A44" BorderThickness="1,0,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" DataContext="{Binding SelectedAsset}">
                    <TextBlock Margin="0,0,0,16" Foreground="#FF83D5FF" FontWeight="SemiBold" Text="ASSET DETAIL" />
                    <TextBlock Foreground="#FF8C98A5" Text="Asset ID" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" FontFamily="Consolas" Text="{Binding AssetIdHex}" />
                    <TextBlock Foreground="#FF8C98A5" Text="Resolved name" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding ResolvedName, TargetNullValue=[unresolved]}" TextWrapping="Wrap" />
                    <TextBlock Foreground="#FF8C98A5" Text="Type" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding Type}" />
                    <TextBlock Foreground="#FF8C98A5" Text="Compression" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding Compression, TargetNullValue='—'}" />
                    <TextBlock Foreground="#FF8C98A5" Text="Last modified" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding LastModified, StringFormat={}{0:u}, TargetNullValue='—'}" />
                    <TextBlock Foreground="#FF8C98A5" Text="Size (bytes)" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding Size, StringFormat={}{0:N0}}" />
                    <TextBlock Foreground="#FF8C98A5" Text="Archive offset" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding Offset, StringFormat=0x{0:X8}}" />
                    <TextBlock Foreground="#FF8C98A5" Text="Archive" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding ArchiveName}" />
                    <TextBlock Foreground="#FF8C98A5" Text="Archive index" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding ArchiveIndex}" />
                    <TextBlock Foreground="#FF8C98A5" Text="Resolved" />
                    <TextBlock Margin="0,2,0,14" Foreground="#FFF1F5F8" Text="{Binding IsUnknown, StringFormat=Unresolved: {0}}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Margin="0,0,0,6" Foreground="#FF83D5FF" FontWeight="SemiBold" Text="JUMP TO" />
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4" Content="Go" Command="{Binding JumpToCommand}" />
                        <TextBox Padding="8,4" Text="{Binding JumpToText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Asset ID (hex) or name" />
                    </DockPanel>

                    <TextBlock Margin="0,14,0,6" Foreground="#FF83D5FF" FontWeight="SemiBold" Text="PRESETS" />
                    <ComboBox ItemsSource="{Binding FilterPresets}" SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="Name" ToolTip="Select a saved filter preset" />
                    <DockPanel LastChildFill="True" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4" Content="Delete" Command="{Binding DeletePresetCommand}" CommandParameter="{Binding SelectedPreset}" />
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4" Content="Apply" Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding SelectedPreset}" />
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4" Content="Save" Command="{Binding SavePresetCommand}" />
                        <TextBox Padding="8,4" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="New preset name" />
                    </DockPanel>

                    <TextBlock Margin="0,14,0,6" Foreground="#FF83D5FF" FontWeight="SemiBold" Text="RECENT SEARCHES" />
                    <ListBox ItemsSource="{Binding RecentSearches}" MaxHeight="90" Background="Transparent" Foreground="#FFE7EDF3" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.RowSpan="2" Grid.ColumnSpan="3" Background="#99000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18" Text="Loading asset catalog..." />
        </Border>
    </Grid>
</UserControl>
