<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>SpiderMan Modding Tool Core Library</Title>
    <Description>Core functionality for Spider-Man Modding Tool shared between GUI and CLI</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="GameDefinitions\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>

</Project>
