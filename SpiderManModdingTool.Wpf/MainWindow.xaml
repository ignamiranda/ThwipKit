<Window x:Class="SpiderManModdingTool.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spider-Man Modding Tool" Height="720" Width="1200" MinHeight="480" MinWidth="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Game Directory..." Click="OpenGameDirectory_Click" />
            </MenuItem>
            <MenuItem Header="_Edit" />
            <MenuItem Header="_View" />
            <MenuItem Header="_Help" />
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding GamePath}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding AssetCount, StringFormat=Assets: {0:N0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
        <Grid Background="#FFF4F4F4">
            <Border Margin="24" Padding="32" Background="White" BorderBrush="#FFD8D8D8" BorderThickness="1">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#FF666666"
                           Text="Asset browser will appear here." />
            </Border>
        </Grid>
    </DockPanel>
</Window>
